# Set to "true" to include the admin dashboard in the build (else it is fully tree-shaken out).
# Then grant access by adding a doc to Firestore's `admins` collection with id = your email (lowercased).
# Firestore rules enforce that only that email can read it.
VITE_ADMIN_ENABLED=false